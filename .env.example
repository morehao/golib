# Database - MySQL DSN used by codegen tests
MYSQL_DSN=root:123456@tcp(127.0.0.1:3306)/demo?charset=utf8mb4&parseTime=True

# Database - MySQL URI used by dbgorm
MYSQL_URI=mysql://root:123456@127.0.0.1:3306/demo?charset=utf8mb4&parseTime=true

# Database - PostgreSQL DSN used by codegen tests
POSTGRES_DSN=host=127.0.0.1 user=postgres password=123456 dbname=demo port=5432 sslmode=disable TimeZone=Asia/Shanghai

# Database - PostgreSQL URI used by dbgorm
POSTGRES_URI=postgres://postgres:123456@127.0.0.1:5432/demo?sslmode=disable

# Redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=123456

# Elasticsearch
ELASTICSEARCH_ADDR=http://localhost:9200

# AES encryption key (optional, used by gcrypto)
GOLIB_AES_KEY=

# RSA private key in PEM format (optional, used by gcrypto)
GOLIB_RSA_PRIVATE_KEY=

# RSA public key in PEM format (optional, used by gcrypto)
GOLIB_RSA_PUBLIC_KEY=

# Object Storage - MinIO / S3-compatible (used by storage driver tests)
STORAGE_MINIO_ENDPOINT=127.0.0.1:9000
STORAGE_MINIO_ACCESS_KEY=minioadmin
STORAGE_MINIO_SECRET_KEY=minioadmin
STORAGE_MINIO_USE_SSL=false
STORAGE_MINIO_BASE_URL=http://127.0.0.1:9000
STORAGE_MINIO_REGION=us-east-1
STORAGE_MINIO_BUCKET=testbucket

# Object Storage - Alibaba Cloud OSS (optional, used by storage driver tests)
STORAGE_OSS_ENDPOINT=
STORAGE_OSS_ACCESS_KEY=
STORAGE_OSS_SECRET_KEY=
STORAGE_OSS_BASE_URL=
STORAGE_OSS_REGION=oss-cn-hangzhou
STORAGE_OSS_BUCKET=

# Object Storage - Tencent Cloud COS (optional, used by storage driver tests)
STORAGE_COS_ENDPOINT=
STORAGE_COS_ACCESS_KEY=
STORAGE_COS_SECRET_KEY=
STORAGE_COS_BASE_URL=
STORAGE_COS_REGION=ap-guangzhou
STORAGE_COS_BUCKET=

# Object Storage - Volcano Engine TOS (optional, used by storage driver tests)
STORAGE_TOS_ENDPOINT=
STORAGE_TOS_ACCESS_KEY=
STORAGE_TOS_SECRET_KEY=
STORAGE_TOS_BASE_URL=
STORAGE_TOS_REGION=cn-beijing
STORAGE_TOS_BUCKET=

# Object Storage - local file system base dir (optional, used by storage driver tests)
STORAGE_LOCAL_DIR=./data
STORAGE_LOCAL_BUCKET=testbucket

# Object Storage - common settings (optional)
STORAGE_TIMEOUT=30s
STORAGE_MAX_RETRIES=3
